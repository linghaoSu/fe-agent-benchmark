flowchart TB
    subgraph ControlPlane["评测控制面"]
        UI["管理后台 / CLI"]
        Scheduler["任务调度器<br/>Run Coordinator"]
        Config["配置中心<br/>Agent / 模型 / Prompt / 预算"]
        Registry["任务仓库<br/>Task Registry"]
        Suite["测试套件<br/>Benchmark / Regression"]
    end

    subgraph AgentLayer["Agent 接入层"]
        Adapter["Agent Adapter"]
        Context["上下文管理器"]
        Model["模型网关"]
        Tools["Tool Router"]
    end

    subgraph SandboxLayer["隔离执行环境"]
        Sandbox["Ephemeral Sandbox<br/>Docker / Firecracker / K8s Job"]
        Repo["代码仓库"]
        Editor["文件编辑工具"]
        Shell["Shell"]
        Browser["Playwright / Chromium"]
        Mock["Mock API"]
        Policy["网络 / 文件 / 资源策略"]
    end

    subgraph Evaluation["验证器流水线"]
        Integrity["Integrity"]
        Build["Build / Typecheck / Lint"]
        Functional["Functional E2E"]
        Visual["Visual / Responsive"]
        A11y["Accessibility"]
        Performance["Performance"]
        Engineering["Engineering"]
        Judge["LLM / VLM Judge"]
    end

    subgraph Storage["数据与观测"]
        Events["Agent Events"]
        Artifacts["Artifact Store"]
        Results["Result Store"]
        Metrics["Metrics"]
        Dashboard["Dashboard"]
    end

