{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["src", "tests/**/*.ts"],
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "types": [
      "node",
      "@dao-style/core/volar.d.ts",
      "@dao-style/extend/volar.d.ts",
      "@rsbuild/core/types",
      "jsdom",
      "vitest/globals"
    ],
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  }
}
