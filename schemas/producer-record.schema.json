{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/producer-record.schema.json",
  "title": "Frontend Agent Producer Record",
  "type": "object",
  "required": [
    "schemaVersion",
    "producerId",
    "attemptId",
    "kind",
    "phase",
    "privateCode",
    "boundedSummary",
    "artifactRefs"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "producerId": {
      "type": "string",
      "minLength": 1
    },
    "attemptId": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "evaluator",
        "policy",
        "adapter",
        "budget",
        "infrastructure"
      ]
    },
    "phase": {
      "type": "string",
      "minLength": 1
    },
    "privateCode": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "boundedSummary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "artifactRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
