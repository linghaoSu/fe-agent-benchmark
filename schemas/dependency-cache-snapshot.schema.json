{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/dependency-cache-snapshot.schema.json",
  "title": "Frontend Agent Dependency Cache Snapshot",
  "type": "object",
  "required": [
    "schemaVersion",
    "dependencyCacheSnapshotId",
    "lockfileHash",
    "proxyConfigurationHash",
    "imageDigest",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "dependencyCacheSnapshotId": {
      "type": "string",
      "minLength": 1
    },
    "lockfileHash": {
      "type": "string",
      "minLength": 1
    },
    "proxyConfigurationHash": {
      "type": "string",
      "minLength": 1
    },
    "imageDigest": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "minLength": 1
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
